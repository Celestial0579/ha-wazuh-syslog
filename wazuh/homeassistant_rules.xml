<!--
  Regeln fuer Home Assistant. Die Gruppe "aussenangriff" haengt die Treffer an
  die bestehende Korrelation an; das Feld srcip macht sie mit den uebrigen
  Quellen vergleichbar.
-->
<!--
  Nummernbereich 100530-100533. 100400-100403 waren belegt (Suricata und
  zz_korrelation) - vor dem Anlegen IMMER den Bestand pruefen, doppelte
  Nummern lassen die Regelpruefung beim Neustart scheitern.
-->
<group name="homeassistant,">

  <rule id="100530" level="0">
    <decoded_as>homeassistant</decoded_as>
    <description>Home Assistant: Meldung</description>
  </rule>

  <rule id="100531" level="5">
    <if_sid>100530</if_sid>
    <match>Login attempt or request with invalid authentication</match>
    <description>Home Assistant: fehlgeschlagene Anmeldung von $(srcip)</description>
    <group>authentication_failed,aussenangriff,</group>
  </rule>

  <!-- Wiederholung aus derselben Quelle: das ist ein Scanner, kein Vertipper. -->
  <rule id="100532" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100531</if_matched_sid>
    <same_srcip />
    <description>Home Assistant: mehrere fehlgeschlagene Anmeldungen von $(srcip)</description>
    <group>authentication_failures,aussenangriff,</group>
  </rule>

  <rule id="100533" level="7">
    <if_sid>100530</if_sid>
    <match>hass_nabucasa|components.cloud</match>
    <description>Home Assistant: Stoerung des Fernzugangs</description>
  </rule>

</group>
